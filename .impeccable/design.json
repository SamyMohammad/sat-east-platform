  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "LoadingButton primary: the one filled blue action per surface (Check, Continue).",
      "html": "<button class=\"ds-btn-primary\">Check</button>",
      "css": ".ds-btn-primary{font-family:Lexend,system-ui,sans-serif;font-size:13px;font-weight:600;line-height:20px;min-height:48px;padding:8px 20px;border:none;border-radius:10px;background:#2F5BEA;color:#FFFFFF;box-shadow:0 1px 0 #14171F1A,0 2px 6px rgba(47,91,234,.25);transition:transform 120ms cubic-bezier(.2,0,0,1);cursor:pointer}.ds-btn-primary:active{transform:scale(.98)}.ds-btn-primary:focus-visible{outline:3px solid #B9C8F8;outline-offset:0}.ds-btn-primary:disabled{background:#E3E6EC;color:#6A7283;box-shadow:none}@media (prefers-reduced-motion:reduce){.ds-btn-primary{transition:none}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "LoadingButton secondary: outlined blue, for the second action.",
      "html": "<button class=\"ds-btn-secondary\">Explore course</button>",
      "css": ".ds-btn-secondary{font-family:Lexend,system-ui,sans-serif;font-size:13px;font-weight:600;min-height:48px;padding:8px 20px;border:1px solid #2F5BEA;border-radius:10px;background:transparent;color:#2F5BEA;transition:transform 120ms cubic-bezier(.2,0,0,1);cursor:pointer}.ds-btn-secondary:active{transform:scale(.98)}.ds-btn-secondary:focus-visible{outline:3px solid #B9C8F8}"
    },
    {
      "name": "Destructive Button",
      "kind": "button",
      "refersTo": "button-destructive",
      "description": "LoadingButton destructive: delete/discard only; never to judge an answer.",
      "html": "<button class=\"ds-btn-danger\">Delete topic</button>",
      "css": ".ds-btn-danger{font-family:Lexend,system-ui,sans-serif;font-size:13px;font-weight:600;min-height:48px;padding:8px 20px;border:none;border-radius:10px;background:#B3342B;color:#FFFFFF;cursor:pointer;transition:background 200ms cubic-bezier(.2,0,0,1)}.ds-btn-danger:hover{background:#962A22}.ds-btn-danger:focus-visible{outline:3px solid #B9C8F8}"
    },
    {
      "name": "Choice Tile",
      "kind": "custom",
      "refersTo": "choice-tile",
      "description": "Answer choice row: letter badge + math content; selected gets wash, brand border and a 3px halo; verdicts add icon + word.",
      "html": "<div class=\"ds-choices\"><button class=\"ds-choice\"><span class=\"ds-badge\">A</span><span>x = 7</span></button><button class=\"ds-choice ds-choice-sel\"><span class=\"ds-badge\">B</span><span>x = 12</span></button><div class=\"ds-choice ds-choice-ok\"><span class=\"ds-badge\">C</span><span>x = 22/3</span><span class=\"ds-status\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg>Correct</span></div></div>",
      "css": ".ds-choices{display:flex;flex-direction:column;gap:12px;max-width:720px;font-family:Lexend,system-ui,sans-serif;}.ds-choice{display:flex;align-items:center;gap:12px;min-height:56px;padding:4px 12px;border:1px solid #E3E6EC;border-radius:12px;background:#FFFFFF;color:#14171F;font:inherit;font-size:15px;text-align:left;cursor:pointer;transition:transform 120ms cubic-bezier(.2,0,0,1)}.ds-choice:hover{border-color:#CDD2DB}.ds-choice:active{transform:scale(.98)}.ds-choice:focus-visible{outline:3px solid #B9C8F8}.ds-badge{display:inline-grid;place-items:center;width:30px;height:30px;border:1.5px solid #CDD2DB;border-radius:999px;font-size:12px;font-weight:600;color:#555C6B}.ds-choice-sel{background:#EEF2FE;border:2px solid #2F5BEA;box-shadow:0 0 0 3px rgba(185,200,248,.45)}.ds-choice-sel .ds-badge{background:#2F5BEA;border-color:#2F5BEA;color:#FFFFFF}.ds-choice-ok{background:#E8F6EE;border:2px solid #137F49}.ds-choice-ok .ds-badge{background:#137F49;border-color:#137F49;color:#FFFFFF}.ds-status{margin-left:auto;display:inline-flex;align-items:center;gap:4px;color:#137F49;font-size:12px;font-weight:600}"
    },
    {
      "name": "Feedback Dock",
      "kind": "custom",
      "refersTo": "feedback-dock-correct",
      "description": "Sticky verdict dock: tints to the verdict wash, icon + word in a live region, teacher line on warm, action re-themed to verdict colour.",
      "html": "<div class=\"ds-dock\"><div class=\"ds-dock-main\"><div class=\"ds-verdict\" role=\"status\" aria-live=\"polite\"><svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m9 12 2 2 4-4\"/></svg>Correct</div><div class=\"ds-teacher\"><strong>A. Elmenshawy</strong><p>Right. Isolate the variable term first, then divide.</p></div></div><button class=\"ds-dock-next\">Next</button></div>",
      "css": ".ds-dock{font-family:Lexend,system-ui,sans-serif;display:flex;gap:24px;align-items:center;padding:12px 16px;background:#E8F6EE;border-top:1px solid #9ED3B5;box-shadow:0 -2px 16px #14171F1A}.ds-dock-main{flex:1;display:flex;flex-direction:column;gap:12px}.ds-verdict{display:flex;align-items:center;gap:12px;color:#137F49;font-size:16px;font-weight:700}.ds-teacher{background:#FFF7EB;border:1px solid #F1D9B5;border-radius:12px;padding:12px}.ds-teacher strong{color:#8A5A12;font-size:12px}.ds-teacher p{margin:8px 0 0;color:#14171F;font-size:15px}.ds-dock-next{min-width:180px;min-height:48px;border:none;border-radius:10px;background:#137F49;color:#FFFFFF;font:inherit;font-size:13px;font-weight:600;cursor:pointer}.ds-dock-next:focus-visible{outline:3px solid #9ED3B5}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "AppFieldBorder: full rounded outline, label always floating inside above the value, 3px brand-line focus.",
      "html": "<label class=\"ds-field\"><span>Email</span><input placeholder=\"you@school.org\"></label>",
      "css": ".ds-field{font-family:Lexend,system-ui,sans-serif;display:flex;flex-direction:column;gap:2px;max-width:360px;padding:8px 12px;border:1px solid #CDD2DB;border-radius:10px;background:#FFFFFF}.ds-field span{font-size:13px;font-weight:600;color:#555C6B}.ds-field input{border:none;outline:none;font:inherit;font-size:15px;color:#14171F;background:transparent}.ds-field input::placeholder{color:#6A7283}.ds-field:focus-within{border:3px solid #B9C8F8;padding:6px 10px}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "AppChip: pill, surface fill; filter kind turns brand wash/brand when selected.",
      "html": "<span class=\"ds-chip\">E · Easy</span> <button class=\"ds-chip ds-chip-on\">Algebra</button>",
      "css": ".ds-chip{font-family:Lexend,system-ui,sans-serif;display:inline-flex;align-items:center;min-height:32px;padding:0 12px;border:1px solid #E3E6EC;border-radius:999px;background:#F6F7F9;color:#14171F;font-size:13px;font-weight:600;transition:background 200ms cubic-bezier(.2,0,0,1)}button.ds-chip{cursor:pointer;border-color:#CDD2DB}button.ds-chip:focus-visible{outline:3px solid #B9C8F8}.ds-chip-on{background:#EEF2FE;border-color:#2F5BEA;color:#2F5BEA}"
    },
    {
      "name": "Course Card",
      "kind": "card",
      "refersTo": "card",
      "description": "CourseCard: flat card with 8px subject-hue band, 40px IconTile, headline title, 24px padding.",
      "html": "<article class=\"ds-card\"><div class=\"ds-band\"></div><div class=\"ds-card-body\"><span class=\"ds-tile\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 7v14\"/><path d=\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"/></svg></span><h3>SAT Math</h3><p>Explore algebra, problem solving, and geometry.</p></div></article>",
      "css": ".ds-card{font-family:Lexend,system-ui,sans-serif;max-width:420px;border:1px solid #E3E6EC;border-radius:12px;background:#FFFFFF;overflow:hidden}.ds-band{height:8px;background:#0E9F8E}.ds-card-body{padding:24px;display:flex;flex-direction:column;gap:16px}.ds-tile{display:grid;place-items:center;width:40px;height:40px;border-radius:10px;background:#F4FCFA;color:#0E9F8E}.ds-card h3{margin:0;font-size:24px;font-weight:600;line-height:32px;color:#14171F}.ds-card p{margin:0;font-size:15px;color:#14171F}"
    },
    {
      "name": "Shell Navigation",
      "kind": "nav",
      "refersTo": "shell-sidebar",
      "description": "Desktop sidebar: surface ground, current item as a raised pill with a hairline border.",
      "html": "<nav class=\"ds-nav\"><a>Home</a><a class=\"ds-nav-on\" aria-current=\"page\">Courses</a><a>Skills</a></nav>",
      "css": ".ds-nav{font-family:Lexend,system-ui,sans-serif;display:flex;flex-direction:column;gap:4px;width:232px;padding:16px 12px;background:#F6F7F9;border-right:1px solid #E3E6EC}.ds-nav a{display:flex;align-items:center;min-height:48px;padding:0 12px;border:1px solid transparent;border-radius:10px;color:#555C6B;font-size:12px;font-weight:600;text-decoration:none;cursor:pointer}.ds-nav a:hover{color:#14171F}.ds-nav a:focus-visible{outline:3px solid #B9C8F8}.ds-nav a.ds-nav-on{background:#FFFFFF;border-color:#E3E6EC;color:#14171F;font-weight:700}"
    }
  ],
  "narrative": {
    "northStar": "The Category Standard, at Full Craft",
    "overview": "Khan Academy's calm and math legibility, Brilliant's polished feedback, Linear/Notion type and spacing discipline, and Duolingo's decisive Check structure without its playful styling. White ground, one cool off-white surface, near-black ink, one confident blue. The question and its feedback own the screen; chrome stays quiet.\n\nDensity is relaxed and phone-first: 48px touch targets, 56px choice rows, a 680-720px content column on desktop. Depth comes from 1px lines and tonal surfaces, with soft shadows reserved for surfaces that act (primary button, sheets, dialogs, the feedback dock). Motion is short and purposeful, and every animation collapses to its end state under reduced motion. Light and dark themes share the same roles; every screen ships in both.\n\nConfirmed rejections (from the approved spec): cold grey SaaS, gamified chrome (points, mascots, confetti), exam-software imitation (Bluebook), clutter at 360px.",
    "keyCharacteristics": [
      "One brand blue for selection and primary action; green and coral only for verdicts.",
      "Status is always icon + word, never colour alone.",
      "Lexend everywhere, tabular numerals for counts, timers and scores; LaTeX via `flutter_math_fork` at 1.21x the surrounding text.",
      "Flat surfaces separated by 1px lines; shadows only on acting surfaces.",
      "Lucide icons through one semantic `AppIcons` map.",
      "unDraw illustrations recoloured to the brand at runtime, never inside the question area."
    ],
    "rules": [
      {
        "name": "The One Blue Rule",
        "body": "Blue means \"act here\" or \"you chose this\". Don't use it for decoration, headings or status.",
        "section": "colors"
      },
      {
        "name": "The Icon-And-Word Rule",
        "body": "Every status (correct, incorrect, warning, offline, locked, saved) shows a Lucide icon and a word. Colour reinforces the meaning; it never carries it alone.",
        "section": "colors"
      },
      {
        "name": "The Teacher's Voice Rule",
        "body": "Warm fill and warm ink are the teacher's voice only. They never mark a verdict. (The warning banner borrows `warm-line` for its border; that is the one shared use.)",
        "section": "colors"
      },
      {
        "name": "The Hue Is Identity Rule",
        "body": "Subject hues identify units and topics. They never signal progress, mastery or correctness.",
        "section": "colors"
      },
      {
        "name": "The Tabular Numbers Rule",
        "body": "Any number that changes in place (counts, timers, scores, topic numbers) uses `AppType.count`, `AppType.timer` or `FontFeature.tabularFigures()`.",
        "section": "typography"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Labels and headings are sentence case. The system has no uppercase or tracked-caps style.",
        "section": "typography"
      },
      {
        "name": "The Acting Surface Rule",
        "body": "Only surfaces that ask for action get a shadow: the primary button, the verdict dock, the save bar, dialogs and sheets. Cards, tiles, chips and nav stay flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** read colours from `context.appColors` and spacing, radius and sizes from `AppSpace` / `AppRadius` / `AppSize`. Check every new screen in light and dark at 360px and 1280px.",
      "**Do** pair every status with a Lucide icon and a word, and put verdicts and errors in a `Semantics(liveRegion: true)`.",
      "**Do** route every animation through `AppMotion.resolve` so it collapses to its end state when animations are disabled.",
